# ip-check-sites.list — domains of IP-echo services
#
# bird-route-manager resolves these domains at every apply and adds their IPs
# to the ISP route list, so they are always reachable via ISP and never
# accidentally routed through the VPN.
#
# One domain per line. Lines starting with # are ignored.

# --- Amazon AWS ---
checkip.amazonaws.com

# --- icanhazip (Cloudflare) ---
icanhazip.com
ipv4.icanhazip.com
ipv6.icanhazip.com

# --- ident.me ---
ident.me
4.ident.me
6.ident.me
tnedi.me

# --- ifconfig ---
ifconfig.me
ipv4.ifconfig.me
ipv6.ifconfig.me
ifconfig.co

# --- ip-api ---
ip-api.com
pro.ip-api.com

# --- ip.sb ---
ip.sb
api.ip.sb
api-ipv4.ip.sb
api-ipv6.ip.sb

# --- seeip.org ---
api.seeip.org
ipv4.seeip.org
ipv6.seeip.org

# --- ipapi.co ---
ipapi.co

# --- ipecho.net ---
ipecho.net

